# ZoomInfo — MCP app with Client Credentials, created in the Developer Portal
# (app "PerimeterWatch Radar", delegated user Seb). See docs/ZOOMINFO.md.
ZI_CLIENT_ID=
ZI_CLIENT_SECRET=
# Discovered from https://mcp.zoominfo.com/.well-known/oauth-authorization-server.
# Leave as-is unless ZoomInfo moves it.
ZI_TOKEN_URL=https://okta-login.zoominfo.com/oauth2/default/v1/token
# Scopes the MCP resource advertises. Adjust only if the token call returns invalid_scope.
ZI_SCOPE=api:data:mcp
# Optional. A 24-hour test token from the portal's "Generate token" button. When set,
# it is used instead of the client-credentials exchange. Local testing only, never Railway.
ZI_BEARER_TOKEN=

# NOTE: the dashboard (Vercel) needs the ZI_* variables too: "Find people" and
# "Get email & phone" call ZoomInfo server-side.

# Postgres (Railway). Locally and on Vercel: the public TCP proxy URL.
# On Railway cron services: the internal ${{Postgres.DATABASE_URL}} reference.
DATABASE_URL=

# Application-layer PII encryption. 32 bytes, base64.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=

# Telegram. Messages carry counts and a link only, never PII.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public base URL of the dashboard (Vercel), used for deep links in notifications
# and as the Entra redirect base. No trailing slash.
DASHBOARD_URL=

# --- Dashboard auth (see src/lib/auth.ts) ---
# Session signing secret, 32+ chars. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Mode 1 (preferred): Microsoft Entra ID, single tenant. Any @perimeterwatch.com work
# account can sign in. Register the app at entra.microsoft.com with redirect URI
# <DASHBOARD_URL>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT=
AUTH_ALLOWED_DOMAIN=perimeterwatch.com
# Mode 2 (fallback, used only when the Entra vars above are absent): one shared password.
AUTH_PASSWORD=

# Anthropic API for profile description generation (claude-haiku-4-5).
# Company-level data only; contact PII never goes to the model.
ANTHROPIC_API_KEY=
