{
  "name": "pw-radar",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:apply": "tsx --env-file-if-exists=.env scripts/db-apply.ts",
    "db:stats": "tsx --env-file-if-exists=.env scripts/db-stats.ts",
    "rescore": "tsx --env-file-if-exists=.env scripts/rescore.ts",
    "zi:discover": "tsx --env-file-if-exists=.env scripts/discover.ts",
    "zi:lookup": "tsx --env-file-if-exists=.env scripts/zi-lookup.ts",
    "zi:probe": "tsx --env-file-if-exists=.env scripts/zi-probe.ts",
    "job:daily": "tsx --env-file-if-exists=.env workers/daily.ts",
    "job:weekly": "tsx --env-file-if-exists=.env workers/weekly.ts"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
